raw.shape)\n\n    missing_in_file = [v for v in column_map.values() if v not in raw.columns]\n    if missing_in_file:\n        print(\"\\nSTOP: these expected column(s) aren't in the second dataset's header:\")\n        print(missing_in_file)\n        print(\"Actual columns found:\", list(raw.columns))\n        print(\"Update SECOND_DATASET_COLUMN_MAP above to match, then re-run this cell.\")\n        return None\n\n    renamed = raw.rename(columns={v: k for k, v in column_map.items()})\n\n    normalized = renamed[\"label\"].map(normalize_label_text)\n    unmatched = renamed.loc[normalized.isna(), \"label\"].unique()\n    if len(unmatched) > 0:\n        print(\"\\nSTOP: these label values don't have a known mapping in LABEL_TEXT_ALIASES:\")\n        print(list(unmatched))\n        print(\"Add them above (or confirm they're classes MQTTEEB-D doesn't have), then re-run.\")\n        return None\n    renamed[\"label\"] = normalized\n\n    return build_feature_frame(renamed)\n\n\nif RUN_CROSS_DATASET_CHECK:\n    second_df = load_second_dataset(SECOND_DATASET_PATH, SECOND_DATASET_COLUMN_MAP)\n    if second_df is not None:\n        # Evaluate the model trained on MQTTEEB-D against the second dataset's traffic,\n        # using the exact same fitted scaler/feature order -- this is the point of the\n        # exercise, so don't refit anything here.\n        X_second_cont = scaler.transform(second_df[[FEATURE_COLUMNS[i] for i in cont_idx]])\n        X_second_cat = second_df[[FEATURE_COLUMNS[i] for i in cat_idx]].values.astype(float)\n        X_second = np.hstack([X_second_cat, X_second_cont])\n        y_second = np.array([label_to_idx.get(c, -1) for c in second_df[LABEL_COL].astype(str)])\n        keep = y_second >= 0  # drop any label MQTTEEB-D's classes don't cover\n        acc, f1_macro, _, _ = evaluate_keras_model(federated_mlp, X_second[keep], y_second[keep])\n        print(f\"Cross-dataset (train on MQTTEEB-D, test on second dataset): accuracy={acc:.4f}  macro-F1={f1_macro:.4f}\")\n    else:\n        print(\"Cross-dataset check skipped -- fix the mapping above and set RUN_CROSS_DATASET_CHECK=True.\")\nelse:\n    print(\"Cross-dataset check is off (RUN_CROSS_DATASET_CHECK=False). Turn it on once the MQTTset CSV is available.\")","metadata":{"trusted":true,"execution":{"execution_failed":"2026-09-13T10:53:38.089Z"}},"outputs":[],"execution_count":null},{"id":"dc69e7a8-377d-4cc6-9bf7-70b7dee61d75","cell_type":"markdown","source":"## Notes for reproducing the numbers in a manuscript draft\n\n- The three numbers the paper's contribution claims rest on: the leakage-inflation gap\n  (section 6.5, `leakage_audit.csv`), the SHAP-vs-chi-squared overlap (section 8), and the\n  cross-dataset accuracy/F1 (section 10). Everything else in the notebook exists to make\n  those three numbers trustworthy, not to be reported as contributions on their own.\n- Split strategy used for the headline numbers: `{SPLIT_STRATEGY}` (see section 3 for the\n  alternative and the cross-loop option).\n- Library versions matter for exact reproducibility -- pin them in the install cell at the\n  top rather than installing/uninstalling mid-notebook.\n- `RESULT_DIR` is timestamped per run; keep the folder for whichever run's numbers end up in\n  the paper, and note the git commit / notebook version alongside it.\n- If you enable `USE_DP = True`, section 6c already sweeps the noise level and reports the\n  accuracy-vs-epsilon tradeoff -- report that curve, not just the single best-case number.\n- Section 6a's DP-SGD accounting uses grouped microbatches (`DP_NUM_MICROBATCHES`), not\n  strict per-example clipping, for tractable runtime on Kaggle -- say so explicitly in the\n  paper's methodology section rather than letting a reviewer assume textbook per-example DP.\n- Section 10's cross-dataset check is wired to MQTTset's real schema already; what's left is\n  downloading `cnrieiit/mqttset` from Kaggle, confirming the two flagged naming uncertainties\n  against the real 