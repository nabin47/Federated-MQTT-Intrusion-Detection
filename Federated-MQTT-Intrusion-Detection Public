lpha in [0.3, 1.0]:\n        for mu in [0.0, FEDPROX_MU if FEDPROX_MU > 0 else 0.01]:\n            algo_name = \"FedAvg\" if mu == 0.0 else \"FedProx\"\n            print(f\"\\n--- ablation: clients={n_clients}, alpha={alpha}, algo={algo_name} (mu={mu}) ---\")\n            model, hist, _ = run_federated_training(\n                X_train_bal, y_train_bal, X_val, y_val, n_clients, alpha,\n                rounds=FED_ROUNDS, local_epochs=LOCAL_EPOCHS, batch_size=BATCH_SIZE,\n                seed=RANDOM_STATE, use_dp=False, fedprox_mu=mu, verbose=False,\n            )\n            acc, f1_macro, _, _ = evaluate_keras_model(model, X_test, y_test)\n            ablation_rows.append({\"num_clients\": n_clients, \"dirichlet_alpha\": alpha,\n                                   \"algorithm\": algo_name, \"test_accuracy\": acc, \"test_f1_macro\": f1_macro})\n            print(f\"  test accuracy={acc:.4f}  test macro-F1={f1_macro:.4f}\")\n\nablation_df = pd.DataFrame(ablation_rows)\nablation_df.to_csv(os.path.join(RESULT_DIR, \"ablation_clients_noniid.csv\"), index=False)\nablation_df","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T09:56:34.056532Z","iopub.execute_input":"2026-09-13T09:56:34.056773Z","execution_failed":"2026-09-13T10:53:38.087Z"}},"outputs":[{"name":"stdout","text":"\n--- ablation: clients=5, alpha=0.3, algo=FedAvg (mu=0.0) ---\n","output_type":"stream"}],"execution_count":null},{"id":"ccb50bc8-e0c7-4fb0-808a-4bbd99cff9f8","cell_type":"markdown","source":"### 6c. Privacy-utility tradeoff for DP-SGD FedAvg\n\nThis is the section that turns \"we added a clip-and-noise step\" into an actual privacy\nclaim: for a small grid of noise multipliers, train federated with DP-SGD enabled, compute\nthe worst-case epsilon the run actually achieved, and plot accuracy against it. A privacy\nclaim without this curve is just an assertion; a paper that reports \"our method is private\"\nwithout ever varying the noise level and showing what it costs is exactly the pattern this\nproject's methodology writeup calls out as a problem in prior work, so it would be\ninconsistent to leave it out here.\n","metadata":{}},{"id":"4ff3ff31-30fc-4ca6-909a-15498c841c16","cell_type":"code","source":"privacy_utility_rows = []\nnoise_grid = [0.0, 0.4, 0.8, 1.2, 1.6]  # 0.0 = DP-SGD machinery on, no noise -- a sanity check\n                                          # that clipping alone doesn't tank accuracy on its own\n\nfor noise_mult in noise_grid:\n    use_dp_this_run = noise_mult > 0\n    print(f\"\\n--- privacy-utility point: noise_multiplier={noise_mult} ---\")\n    DP_NOISE_MULTIPLIER = noise_mult  # run_federated_training reads this module-level constant\n    model, hist, epsilon = run_federated_training(\n        X_train_bal, y_train_bal, X_val, y_val, NUM_CLIENTS, DIRICHLET_ALPHA,\n        rounds=FED_ROUNDS, local_epochs=LOCAL_EPOCHS, batch_size=BATCH_SIZE,\n        seed=RANDOM_STATE, use_dp=use_dp_this_run, fedprox_mu=0.0, verbose=False,\n    )\n    acc, f1_macro, _, _ = evaluate_keras_model(model, X_test, y_test)\n    privacy_utility_rows.append({\n        \"noise_multiplier\": noise_mult, \"epsilon\": epsilon,\n        \"test_accuracy\": acc, \"test_f1_macro\": f1_macro,\n    })\n    if epsilon is not None:\n        eps_str = f\"{epsilon:.2f}\"\n    elif not use_dp_this_run:\n        eps_str = \"n/a (no DP applied at this noise level -- this is the plain-FedAvg reference point)\"\n    else:\n        eps_str = \"n/a (dp_accounting isn't installed, so no epsilon could be computed)\"\n    print(f\"  epsilon={eps_str}  test accuracy={acc:.4f}  test macro-F1={f1_macro:.4f}\")\n\nDP_NOISE_MULTIPLIER = 0.8  # restore the configured default now that the sweep is done\n\nprivacy_utility_df = pd.DataFrame(privacy_utility_rows)\nprivacy_utility_df.to_csv(os.path.join(RESULT_DIR, \"privacy_utility_tradeoff.csv\"), index=False)\n\nif privacy_utility_df[\"epsilon\"].notna().any():\n    plt.figure(figsize=(7, 4))\n    finite = privacy_utility_df.dropna(subset=[\"epsilon\"])\n    plt.plot(finite[\"epsilon\"], finite[\"test_f1_macro\"], marker=\"o\")\n    plt.xlabel(\"epsilon (worst-case, delta=%.0e)\" % DP_TARGET_DELTA)\n    plt.ylabel(\"test macro-F1\")\n    plt.title(\"Privacy-utility tradeoff, DP-SGD FedAvg\")\n    plt.tight_layout()\n    plt.savefig(os.path.join(RESULT_DIR, \"privacy_utility_tradeoff.png\"))\n    plt.show()\n\nprivacy_utility_df","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-13T11:07:20.193227Z","iopub.execute_input":"2026-09-13T11:07:20.193681Z","iopub.status.idle":"2026-09-13T11:07:20.267427Z","shell.execute_reply.started":"2026-09-13T11:07:20.193655Z","shell.execute_reply":"2026-09-13T11:07:20.266579Z"}},"outputs":[{"name":"stdout","text":"\n--- privacy-utility point: noise_multiplier=0.0 ---\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mNameError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_40/534427933.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m      7\u001b[0m     \u001b[0mprint\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34mf\"\\n--- privacy-utility point: noise_multiplier={noise_mult} ---\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      8\u001b[0m     \u001b[0mDP_NOISE_MULTIPLIER\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mnoise_mult\u001b[0m  \u001b[0;31m# run_federated_training reads this module-level constant\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m----> 9\u001b[0;31m     model, hist, epsilon = run_federated_training(\n\u001b[0m\u001b[1;32m     10\u001b[0m         \u001b[0mX_train_bal\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0my_train_bal\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mX_val\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0my_val\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mNUM_CLIENTS\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mDIRICHLET_ALPHA\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     11\u001b[0m         \u001b[0mrounds\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mFED_ROUNDS\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlocal_epochs\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mLOCAL_EPOCHS\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mbatch_size\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mBATCH_SIZE\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mNameError\u001b[0m: name 'run_federated_training' is not defined"],"ename":"NameError","evalue":"name 'run_federated_training' is not defined","output_type":"error"}],"execution_count":1},{"id":"10f07c43-05c5-4157-ad72-e184ace5fdac","cell_type":"markdown","source":"## 7. Multi-seed comparison with a significance test\n\nEverything above used a single seed. Here we repeat the centralized-vs-federated\ncomparison across several seeds and run a Wilcoxon signed-rank test on the paired\nmacro-F1 scores, since that's the question a reviewer will actually ask: is the\ndifference between these two real, or within the noise of random initialization and\ndata ordering?\n","metadata":{}},{"id":"475c8703-31f2-42ed-8e80-27832376829a","cell_type":"code","source":"centralized_scores, federated_scores = [], []\n\nfor seed in range(RANDOM_STATE, RANDOM_STATE + N_SEEDS):\n    print(f\"\\n=== seed {seed} ===\")\n    set_all_seeds(seed)\n    c_model = build_mlp(INPUT_DIM, NUM_CLASSES)\n    c_model.fit(X_train_bal, y_train_bal, epochs=LOCAL_EPOCHS * FED_ROUNDS,\n                batch_size=BATCH_SIZE, verbose=0)\n    _, c_f1, _, _ = evaluate_keras_model(c_model, X_test, y_test, name=\"  centralized\")\n    centralized_scores.append(c_f1)\n\n    f_model, _, _ = run_federated_training(\n        X_train_bal, y_train_bal, X_val, y_val, NUM_CLIENTS, DIRICHLET_ALPHA,\n        FED_ROUNDS, LOCAL_EPOCHS, BATCH_SIZE, seed, use_dp=USE_DP, fedprox_mu=FEDPROX_MU, verbose=False,\n    )\n    _, f_f1, _, _ = evaluate_keras_model(f_model, X_test, y_test, name=\"  federated\")\n    federated_scores.append(f_f1)\n\nsummary = pd.DataFrame({\n    \"seed\": list(range(RANDOM_STATE, RANDOM_STATE + N_SEEDS)),\n    \"centralized_f1_macro\": centralized_scores,\n    \"federated_f1_macro\": federated_scores,\n})\nprint(\"\\n\", summary)\nprint(f\"\\ncentralized: {np.mean(centralized_scores):.4f} +/- {np.std(centralized_scores):.4f}\")\nprint(f\"federated:   {np.mean(federated_scores):.4f} +/- {np.std(federated_scores):.4f}\")\n\nstat, p_value = wilcoxon(centralized_scores, federated_scores)\nprint(f\"\\nWilcoxon signed-rank test (centralized vs. federated macro-F1): stat={stat:.3f}, p={p_value:.4f}\")\nif p_value < 0.05:\n    print(\"Difference is significant at alpha=0.05 -- report which direction, don't just say 'significant'.\")\nelse:\n    print(\"No significant difference at alpha=0.05 across these seeds -- that's actually a good result to\")\n    print(\"report for a federated-learning paper: it means privacy/data-locality didn't cost accuracy.\")\n\nsummary.to_csv(os.path.join(RESULT_DIR, \"multiseed_comparison.csv\"), index=False)","metadata":{"trusted":true,"execution":{"execution_failed":"2026-09-13T10:53:38.088Z"}},"outputs":[],"execution_count":null},{"id":"159ab5f2-ce7e-4452-bc9c-c77a459dfd2a","cell_type":"markdown","source":"## 8. Explainability: SHAP, checked against the dataset paper's own feature ranking\n\nThe dataset paper's chi-squared analysis (their Fig. 5) flagged `mqtt_hdrflags`,\n`tcp_flags`, and `mqtt_conack_flags` as the most discriminative fields. If our model's SHAP\nranking roughly agrees, that's a genuinely useful cross-validation of both the dataset and\nthe model. If `mqtt_msg_length`/`mqtt_msg_char_diversity` dominate instead, or the raw\nmessage artifact concern from section 2 turns out to matter, that's worth flagging in the\npaper rather than quietly reporting the accuracy number.\n","metadata":{}},{"id":"faf94825-d6d5-475c-8ad5-7aa272b744bd","cell_type":"code","source":"explainer = shap.TreeExplainer(xgb_model)\nsample = pd.DataFrame(X_test, columns=ordered_feature_names).sample(\n    n=min(1500, X_test.shape[0]), random_state=RANDOM_STATE)\nshap_values = explainer(sample)\n\nplt.figure()\nshap.summary_plot(shap_values, sample, show=False, plot_type=\"bar\")\nplt.tight_layout()\nplt.savefig(os.path.join(RESULT_DIR, \"shap_importance.png\"))\nplt.show()\n\nmean_abs_shap = np.abs(shap_values.values).mean(axis=(0, 2)) if shap_values.values.ndim == 3 else np.abs(shap_values.values).mean(axis=0)\nshap_ranking = pd.Series(mean_abs_shap, index=ordered_feature_names).sort_values(ascending=False)\nprint(\"SHAP feature ranking (mean |SHAP value|):\")\nprint(shap_ranking)\n\npaper_top_features = [\"mqtt_hdrflags\", \"tcp_flags\", \"mqtt_conack_flags\"]\nour_top_features = shap_ranking.head(3).index.tolist()\nprint(f\"\\nDataset paper's chi-squared top-3: {paper_top_features}\")\nprint(f\"Our SHAP top-3:                    {our_top_features}\")\noverlap = set(paper_top_features) & set(our_top_features)\nprint(f\"Overlap: {overlap if overlap else 'none -- worth a closer look before writing this up as agreement'}\")\n\nmsg_features = [f for f in [\"mqtt_msg_length\", \"mqtt_msg_char_diversity\"] if f in shap_ranking.index]\nif msg_features and shap_ranking[msg_features].sum() > shap_ranking.iloc[0]:\n    print(\"\\nNote: derived message features rank unusually high -- worth checking these aren't\")\n    print(\"still an artifact of how the attack payloads were generated on this testbed.\")","metadata":{"trusted":true,"execution":{"execution_failed":"2026-09-13T10:53:38.088Z"}},"outputs":[],"execution_count":null},{"id":"44fe5b54-c93b-446f-a75b-d91ea9480648","cell_type":"markdown","source":"## 9. Final comparison table\n\nEverything in one place, saved next to the figures so a manuscript draft can point at a\nspecific `RESULT_DIR` and reproduce exactly this table. The naive-pipeline row is included\ndeliberately -- it's the leakage-inflation gap from Section 6.5, not a model being proposed\nfor use, and it should stay in the table so the corrected numbers are read next to what a\nless careful pipeline would have reported on the same data.\n","metadata":{}},{"id":"a7db3a5e-da49-45b8-b162-b04b8bce560e","cell_type":"code","source":"final_rows = [\n    {\"model\": \"Naive pipeline (leaky, for comparison only)\",\n     \"accuracy\": leakage_audit_result[\"naive_accuracy\"], \"f1_macro\": leakage_audit_result[\"naive_f1_macro\"]},\n]\nfinal_rows += list(baseline_results)\nfinal_rows.append({\"model\": \"Centralized MLP\", \"accuracy\": evaluate_keras_model(centralized_mlp, X_test, y_test)[0],\n                    \"f1_macro\": evaluate_keras_model(centralized_mlp, X_test, y_test)[1]})\nfinal_rows.append({\"model\": \"Federated MLP (FedAvg)\", \"accuracy\": evaluate_keras_model(federated_mlp, X_test, y_test)[0],\n                    \"f1_macro\": evaluate_keras_model(federated_mlp, X_test, y_test)[1]})\n\nfinal_table = pd.DataFrame(final_rows)\nfinal_table.to_csv(os.path.join(RESULT_DIR, \"final_comparison_table.csv\"), index=False)\nfinal_table","metadata":{"trusted":true,"execution":{"execution_failed":"2026-09-13T10:53:38.088Z"}},"outputs":[],"execution_count":null},{"id":"b98a74c1-9446-401e-866d-0bb1f5d60dd1","cell_type":"markdown","source":"## 10. Cross-dataset generalization\n\nA result that only holds on one testbed's data is a much weaker claim than one that holds\nacross two independently collected datasets, and reviewers on this topic will ask whether\nthe conclusion is specific to MQTTEEB-D. MQTTset (Vaccari et al., 2020, Sensors) is the\nnatural second dataset -- the MQTTEEB-D dataset paper itself benchmarks against it, it's\nthe most-cited prior MQTT IDS dataset, and it's freely downloadable from Kaggle\n(`cnrieiit/mqttset`), so this doesn't need a new data-collection effort, just a download.\n\nMQTTset's raw CSVs (`train70.